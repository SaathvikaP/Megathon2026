# =============================================================================
# Shared Supabase project — reuse it, do NOT create a second project.
# Project ref: umewelsxflzklynuibbh
# Dashboard:   https://supabase.com/dashboard/project/umewelsxflzklynuibbh
# =============================================================================
# Copy this file to `frontend/.env.local` (git-ignored) and fill in real values from
# Dashboard → Project Settings → API. Never commit real values.
# Next.js only reads env files from this folder; `npm run db:verify` reads the same file.

# --- Used by the web app ------------------------------------------------------
# Public project URL.
NEXT_PUBLIC_SUPABASE_URL=https://umewelsxflzklynuibbh.supabase.co

# Anon / publishable key. Safe in the browser ONLY because every table has RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Base URL used in auth email links (sign-up confirmation, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for a local Supabase stack (supabase start); leave unset otherwise.
# ALLOW_NON_PROJECT_SUPABASE_URL=true

# --- NOT used by the app -------------------------------------------------------
# The app never uses the service-role/secret key or the database password.
# Do not add them here. If you need a direct Postgres connection for the
# Supabase CLI or a database client, enter it in that tool's own credential
# store (see docs/DATABASE_SETUP.md), never in a NEXT_PUBLIC_ variable.

# --- Optional: AI comic image generation (server-only) ---------------------------
# Used only by the admin comic editor's "Generate comic image" button. Read on the
# server; never prefix it with NEXT_PUBLIC_. Only the comic script is sent.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Optional: npm run db:verify signed-in check --------------------------------
# An existing low-privilege TEST account (never a real student or an admin).
# VERIFY_EMAIL=
# VERIFY_PASSWORD=
